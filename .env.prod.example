# Template for the VM-local .env.prod (docker-compose.prod.yml --env-file .env.prod).
# Copy to .env.prod on the VM and fill in real values. Never commit .env.prod itself.

# Postgres / Quarkus datasource (shared instance, see deploy/postgres/init-keycloak-db.sh)
DB_USER=partnerportal
DB_PASSWORD=change-me

# Keycloak admin console credentials
KC_ADMIN_PASSWORD=change-me

# Production domain (placeholder until task 6.1 - Tobias picks/acquires a domain).
# Used by Caddy (TLS + routing) and Keycloak (KC_HOSTNAME, token issuer).
DOMAIN=CHANGE_ME.example.com

# Image tag to deploy; the deploy job / manual rollback overrides this to a specific
# git SHA (see docs/DEPLOYMENT.md "Rollback").
IMAGE_TAG=latest

# Opt-in demo data seed (partners, products, enablements, order history) for a still-empty
# VM database - leave false/unset for real customer data. Turn back off (and clear seeded
# rows) before onboarding real partners/articles (docs/DEPLOYMENT.md).
# SEED_DEMO_DATA=false

# Order e-mails (send-order-emails, docs/DEPLOYMENT.md). Keep disabled until SMTP data exists.
# While the VM holds demo data / known demo logins: always set PAPO_MAIL_REDIRECT_TO to a test
# inbox; PAPO_MAIL_ALLOW_REAL_RECIPIENTS=true only after Chris approves real recipients.
# PAPO_MAIL_ENABLED=false
# PAPO_MAIL_FROM=PAPO Partnerportal <bestellungen@example.com>
# PAPO_MAIL_COMPANY_RECIPIENT=bestellungen@example.com
# PAPO_MAIL_REDIRECT_TO=testpostfach@example.com
# PAPO_MAIL_ALLOW_REAL_RECIPIENTS=false
# PAPO_MAIL_SHIPPING_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=change-me
# SMTP_PASSWORD=change-me
# Port 587: SMTP_START_TLS=REQUIRED, SMTP_TLS=false. Port 465: SMTP_TLS=true, SMTP_START_TLS=DISABLED.
# SMTP_START_TLS=REQUIRED
# SMTP_TLS=false
