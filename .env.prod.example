# Template for the VM-local .env.prod (docker-compose.prod.yml --env-file .env.prod).
# Copy to .env.prod on the VM and fill in real values. Never commit .env.prod itself.

# Postgres / Quarkus datasource (shared instance, see deploy/postgres/init-keycloak-db.sh)
DB_USER=partnerportal
DB_PASSWORD=change-me

# Keycloak admin console credentials
KC_ADMIN_PASSWORD=change-me

# Production domain (placeholder until task 6.1 - Tobias picks/acquires a domain).
# Used by Caddy (TLS + routing) and Keycloak (KC_HOSTNAME, token issuer).
DOMAIN=CHANGE_ME.example.com

# Image tag to deploy; the deploy job / manual rollback overrides this to a specific
# git SHA (see docs/DEPLOYMENT.md "Rollback").
IMAGE_TAG=latest
