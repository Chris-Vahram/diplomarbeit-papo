{
  "realm": "partnerportal",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "company", "description": "Company / operator role - manages partners, products, enablement, order status" },
      { "name": "partner", "description": "Sales partner role - places orders, views own data" }
    ]
  },
  "clients": [
    {
      "clientId": "partnerportal-frontend",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://__DOMAIN__/*"],
      "webOrigins": ["https://__DOMAIN__"]
    }
  ]
}
