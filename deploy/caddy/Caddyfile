# Production reverse proxy - single domain, path-based routing (design.md Decision 4).
# {$DOMAIN} is a Caddy-native env var placeholder (docker-compose.prod.yml injects it).
# Until a real domain is chosen (tasks.md 6.1), DOMAIN can point at the VM's IP/localhost -
# Caddy only attempts Let's Encrypt issuance for a real hostname, so this is safe to run early.

{$DOMAIN} {
	# Keycloak - KC_HTTP_RELATIVE_PATH=/auth on the keycloak service already expects the
	# /auth prefix in the incoming path, so it must NOT be stripped here (plain `handle`,
	# not `handle_path`).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Backend - every @Path already starts with /api (see ProductResource etc.), so the
	# prefix must reach the app unstripped here too.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Public partner shops (add-partner-shop-foundation): every /shop/<kennung> path gets the
	# separate shop.html entry, which loads no portal code. Must stay before the static handler.
	# noindex is fixed here (and in shop.html) on purpose: papo.shop.indexing-enabled only
	# covers the API; page indexing for released live shops needs its own later change.
	# Bare /shop is included so it never falls through to the 404 page.
	@shop path /shop /shop/* /shop.html
	handle @shop {
		root * /srv/frontend-live/current
		header X-Robots-Tag noindex
		rewrite * /shop.html
		file_server
	}

	# Internal portal (add-public-landing-page): the hash-routed SPA lives under /portal/.
	# Every /portal/* path gets index.html; assets stay absolute (/src, /vendor, /assets).
	redir /portal /portal/ 308
	handle /portal/* {
		root * /srv/frontend-live/current
		header X-Robots-Tag noindex
		rewrite * /index.html
		file_server
	}

	# Static frontend - public pages and files. /srv/frontend-live is bind-mounted into the
	# Caddy container (docker-compose.prod.yml); `current` is a symlink deploy repoints per
	# release (ci-cd.yml), so this always serves the latest release without a container restart.
	# No SPA fallback any more: unknown paths end in handle_errors below (real 404).
	handle {
		root * /srv/frontend-live/current
		rewrite / /landing.html
		rewrite /impressum /impressum.html
		rewrite /datenschutz /datenschutz.html
		try_files {path}
		file_server
	}

	handle_errors 404 {
		root * /srv/frontend-live/current
		header X-Robots-Tag noindex
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}
