# Production reverse proxy config (design.md Decision 1 + 4): single domain,
# path-based routing, automatic HTTPS. {$DOMAIN} is interpolated from the
# container's DOMAIN env var (set in .env.prod).
{$DOMAIN} {
	route /api/* {
		reverse_proxy backend:8080
	}

	route /auth/* {
		reverse_proxy keycloak:8080
	}

	route {
		root * /srv/frontend
		file_server
		try_files {path} /index.html
	}
}
