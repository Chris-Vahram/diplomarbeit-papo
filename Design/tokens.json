{
  "$schema": "https://design-tokens.github.io/dtcg/format/",
  "$metadata": {
    "name": "Partnerportal Design System",
    "version": "1.1.0",
    "project": "PAPO Diplomarbeit"
  },

  "color": {
    "white": { "$value": "#FFFFFF", "$type": "color" },
    "black": { "$value": "#000000", "$type": "color" },

    "primary": {
      "$description": "Brand green — main actions, company context",
      "50":  { "$value": "#f0f7f1", "$type": "color" },
      "100": { "$value": "#d8eedb", "$type": "color" },
      "200": { "$value": "#b4dbb8", "$type": "color" },
      "300": { "$value": "#8dc492", "$type": "color" },
      "400": { "$value": "#78b07e", "$type": "color" },
      "500": { "$value": "#689c6d", "$type": "color", "$description": "Core primary" },
      "600": { "$value": "#578462", "$type": "color", "$description": "Primary hover" },
      "700": { "$value": "#456851", "$type": "color" },
      "800": { "$value": "#344e3d", "$type": "color" },
      "900": { "$value": "#223529", "$type": "color" },
      "950": { "$value": "#111a14", "$type": "color" }
    },

    "secondary": {
      "$description": "Muted teal — supporting elements, backgrounds",
      "50":  { "$value": "#f0f5f5", "$type": "color" },
      "100": { "$value": "#d8eae8", "$type": "color" },
      "200": { "$value": "#bcd8d5", "$type": "color" },
      "300": { "$value": "#abc7c4", "$type": "color", "$description": "Core secondary" },
      "400": { "$value": "#8eb3b0", "$type": "color" },
      "500": { "$value": "#729f9b", "$type": "color" },
      "600": { "$value": "#598c89", "$type": "color" },
      "700": { "$value": "#456f6d", "$type": "color" },
      "800": { "$value": "#345250", "$type": "color" },
      "900": { "$value": "#223534", "$type": "color" }
    },

    "accent": {
      "$description": "Blue-green — partner context, highlights",
      "50":  { "$value": "#eff5f6", "$type": "color" },
      "100": { "$value": "#d4e8eb", "$type": "color" },
      "200": { "$value": "#b4d4da", "$type": "color" },
      "300": { "$value": "#9ac2c9", "$type": "color" },
      "400": { "$value": "#8cacb3", "$type": "color", "$description": "Core accent / partner context" },
      "500": { "$value": "#7597a0", "$type": "color" },
      "600": { "$value": "#5e838d", "$type": "color", "$description": "Partner active nav, partner CTA" },
      "700": { "$value": "#4a6870", "$type": "color" },
      "800": { "$value": "#374e54", "$type": "color" },
      "900": { "$value": "#243438", "$type": "color" }
    },

    "neutral": {
      "$description": "Green-tinted slate — text, borders, backgrounds",
      "50":  { "$value": "#f6f9f7", "$type": "color", "$description": "App background" },
      "100": { "$value": "#edf2ee", "$type": "color" },
      "200": { "$value": "#d6e1d8", "$type": "color" },
      "300": { "$value": "#b5c8b9", "$type": "color" },
      "400": { "$value": "#8ca594", "$type": "color" },
      "500": { "$value": "#69836f", "$type": "color" },
      "600": { "$value": "#52675a", "$type": "color" },
      "700": { "$value": "#3d4f43", "$type": "color" },
      "800": { "$value": "#2a362e", "$type": "color" },
      "900": { "$value": "#182019", "$type": "color" },
      "950": { "$value": "#0b110c", "$type": "color", "$description": "Primary text" }
    },

    "success": {
      "50":  { "$value": "#ecfdf4", "$type": "color" },
      "100": { "$value": "#d0fae5", "$type": "color" },
      "500": { "$value": "#22c55e", "$type": "color" },
      "600": { "$value": "#16a34a", "$type": "color" },
      "700": { "$value": "#15803d", "$type": "color" },
      "800": { "$value": "#166534", "$type": "color" }
    },

    "warning": {
      "50":  { "$value": "#fffbeb", "$type": "color" },
      "100": { "$value": "#fef3c7", "$type": "color" },
      "500": { "$value": "#f59e0b", "$type": "color" },
      "600": { "$value": "#d97706", "$type": "color" },
      "700": { "$value": "#b45309", "$type": "color" },
      "800": { "$value": "#92400e", "$type": "color" }
    },

    "error": {
      "50":  { "$value": "#fef2f2", "$type": "color" },
      "100": { "$value": "#fee2e2", "$type": "color" },
      "500": { "$value": "#ef4444", "$type": "color" },
      "600": { "$value": "#dc2626", "$type": "color" },
      "700": { "$value": "#b91c1c", "$type": "color" },
      "800": { "$value": "#991b1b", "$type": "color" }
    },

    "info": {
      "50":  { "$value": "#eff5f6", "$type": "color" },
      "100": { "$value": "#d4e8eb", "$type": "color" },
      "500": { "$value": "#8cacb3", "$type": "color" },
      "600": { "$value": "#5e838d", "$type": "color" },
      "800": { "$value": "#374e54", "$type": "color" }
    }
  },

  "semantic": {
    "bg": {
      "page":    { "$value": "{color.neutral.50}",  "$type": "color" },
      "surface": { "$value": "{color.white}",        "$type": "color" },
      "subtle":  { "$value": "{color.neutral.100}",  "$type": "color" },
      "overlay": { "$value": "rgba(11, 17, 12, 0.50)", "$type": "color" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}", "$type": "color" },
      "strong":  { "$value": "{color.neutral.300}", "$type": "color" },
      "focus":   { "$value": "{color.primary.500}", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.950}", "$type": "color" },
      "secondary": { "$value": "{color.neutral.600}", "$type": "color" },
      "disabled":  { "$value": "{color.neutral.400}", "$type": "color" },
      "inverse":   { "$value": "{color.white}",       "$type": "color" },
      "brand":     { "$value": "{color.primary.500}", "$type": "color" },
      "partner":   { "$value": "{color.accent.600}",  "$type": "color" }
    },
    "status": {
      "submitted": {
        "bg":   { "$value": "{color.warning.100}", "$type": "color" },
        "text": { "$value": "{color.warning.800}", "$type": "color" }
      },
      "reviewed": {
        "bg":   { "$value": "{color.info.100}",    "$type": "color" },
        "text": { "$value": "{color.info.800}",    "$type": "color" }
      },
      "fulfilled": {
        "bg":   { "$value": "{color.success.100}", "$type": "color" },
        "text": { "$value": "{color.success.800}", "$type": "color" }
      },
      "active": {
        "bg":   { "$value": "{color.success.50}",  "$type": "color" },
        "text": { "$value": "{color.success.700}", "$type": "color" }
      },
      "inactive": {
        "bg":   { "$value": "{color.neutral.100}", "$type": "color" },
        "text": { "$value": "{color.neutral.500}", "$type": "color" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": { "$value": "'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'Fira Code', 'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "fontSize": {
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "14px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "lg":   { "$value": "18px", "$type": "dimension" },
      "xl":   { "$value": "20px", "$type": "dimension" },
      "2xl":  { "$value": "24px", "$type": "dimension" },
      "3xl":  { "$value": "30px", "$type": "dimension" },
      "4xl":  { "$value": "36px", "$type": "dimension" },
      "5xl":  { "$value": "48px", "$type": "dimension" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2, "$type": "number" },
      "snug":    { "$value": 1.3, "$type": "number" },
      "normal":  { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.6, "$type": "number" }
    },
    "letterSpacing": {
      "tight":   { "$value": "-0.025em", "$type": "dimension" },
      "normal":  { "$value": "0em",      "$type": "dimension" },
      "wide":    { "$value": "0.025em",  "$type": "dimension" },
      "wider":   { "$value": "0.05em",   "$type": "dimension" },
      "widest":  { "$value": "0.1em",    "$type": "dimension" }
    }
  },

  "spacing": {
    "0":  { "$value": "0px",   "$type": "dimension" },
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "7":  { "$value": "28px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "14": { "$value": "56px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "20": { "$value": "80px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" },
    "32": { "$value": "128px", "$type": "dimension" }
  },

  "borderRadius": {
    "none": { "$value": "0px",    "$type": "dimension" },
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "6px",    "$type": "dimension" },
    "lg":   { "$value": "8px",    "$type": "dimension" },
    "xl":   { "$value": "12px",   "$type": "dimension" },
    "2xl":  { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "shadow": {
    "xs":  { "$value": "0 1px 2px 0 rgba(11, 17, 12, 0.05)", "$type": "shadow" },
    "sm":  { "$value": "0 1px 3px 0 rgba(11, 17, 12, 0.09), 0 1px 2px -1px rgba(11, 17, 12, 0.09)", "$type": "shadow" },
    "md":  { "$value": "0 4px 6px -1px rgba(11, 17, 12, 0.09), 0 2px 4px -2px rgba(11, 17, 12, 0.09)", "$type": "shadow" },
    "lg":  { "$value": "0 10px 15px -3px rgba(11, 17, 12, 0.09), 0 4px 6px -4px rgba(11, 17, 12, 0.09)", "$type": "shadow" },
    "xl":  { "$value": "0 20px 25px -5px rgba(11, 17, 12, 0.09), 0 8px 10px -6px rgba(11, 17, 12, 0.09)", "$type": "shadow" },
    "focus-ring":         { "$value": "0 0 0 3px rgba(104, 156, 109, 0.35)", "$type": "shadow" },
    "focus-ring-partner": { "$value": "0 0 0 3px rgba(140, 172, 179, 0.40)", "$type": "shadow" }
  },

  "zIndex": {
    "base":     { "$value": 0,   "$type": "number" },
    "raised":   { "$value": 10,  "$type": "number" },
    "dropdown": { "$value": 100, "$type": "number" },
    "sticky":   { "$value": 200, "$type": "number" },
    "overlay":  { "$value": 300, "$type": "number" },
    "modal":    { "$value": 400, "$type": "number" },
    "toast":    { "$value": 500, "$type": "number" },
    "tooltip":  { "$value": 600, "$type": "number" }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "50ms",  "$type": "duration" },
      "fast":    { "$value": "100ms", "$type": "duration" },
      "normal":  { "$value": "150ms", "$type": "duration" },
      "slow":    { "$value": "250ms", "$type": "duration" },
      "slower":  { "$value": "350ms", "$type": "duration" }
    },
    "easing": {
      "linear":      { "$value": "linear",                           "$type": "cubicBezier" },
      "ease-in":     { "$value": "cubic-bezier(0.4, 0, 1, 1)",      "$type": "cubicBezier" },
      "ease-out":    { "$value": "cubic-bezier(0, 0, 0.2, 1)",      "$type": "cubicBezier" },
      "ease-in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",    "$type": "cubicBezier" },
      "spring":      { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  },

  "layout": {
    "sidebarWidth":          { "$value": "240px",  "$type": "dimension" },
    "sidebarWidthCollapsed": { "$value": "64px",   "$type": "dimension" },
    "topbarHeight":          { "$value": "64px",   "$type": "dimension" },
    "contentMaxWidth":       { "$value": "1280px", "$type": "dimension" },
    "contentPaddingDesktop": { "$value": "32px",   "$type": "dimension" },
    "contentPaddingMobile":  { "$value": "16px",   "$type": "dimension" }
  },

  "breakpoint": {
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  }
}
