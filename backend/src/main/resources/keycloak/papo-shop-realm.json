{
  "realm": "papo-shop",
  "displayName": "PAPO Kundenkonto",
  "loginTheme": "papo",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["de"],
  "defaultLocale": "de",
  "localizationTexts": {
    "de": {
      "emailVerificationSubject": "Bitte bestätigen Sie Ihre E-Mail-Adresse",
      "emailVerificationBody": "Sie haben ein PAPO-Kundenkonto mit dieser E-Mail-Adresse erstellt. Bitte bestätigen Sie die Adresse, indem Sie diesen Link öffnen:\n\n{0}\n\nSie müssen keinen Code eingeben. Der Link ist {3} gültig.\n\nFalls Sie kein Konto erstellt haben, können Sie diese E-Mail ignorieren.",
      "emailVerificationBodyHtml": "<p>Sie haben ein PAPO-Kundenkonto mit dieser E-Mail-Adresse erstellt. Bitte bestätigen Sie die Adresse mit einem Klick auf diesen Link:</p><p><a href=\"{0}\">E-Mail-Adresse bestätigen</a></p><p>Sie müssen keinen Code eingeben. Der Link ist {3} gültig.</p><p>Falls Sie kein Konto erstellt haben, können Sie diese E-Mail ignorieren.</p>"
    }
  },
  "passwordPolicy": "length(10) and maxLength(128) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@papo.localhost",
    "fromDisplayName": "PAPO Shop",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": []
  },
  "clients": [
    {
      "clientId": "papo-shop-frontend",
      "name": "PAPO Shop",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/shop/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/shop/*"
      }
    },
    {
      "clientId": "papo-shop-admin",
      "name": "PAPO Backend (Kontolöschung)",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-shop-admin-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-papo-shop-admin",
      "enabled": true,
      "serviceAccountClientId": "papo-shop-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "username": "kunde-demo@papo.local",
      "enabled": true,
      "emailVerified": true,
      "email": "kunde-demo@papo.local",
      "firstName": "Erika",
      "lastName": "Muster",
      "credentials": [{ "type": "password", "value": "kunde-demo-1", "temporary": false }]
    }
  ]
}
